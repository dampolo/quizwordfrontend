diff --git a/src/quiz/my-quiz/AddNewWord/add-new-word.test.jsx b/src/quiz/my-quiz/AddNewWord/add-new-word.test.jsx
new file mode 100644
index 0000000..701e26a
--- /dev/null
+++ b/src/quiz/my-quiz/AddNewWord/add-new-word.test.jsx
@@ -0,0 +1,61 @@
+import { afterEach, expect, it, vi } from "vitest";
+import { cleanup, render } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { MemoryRouter } from "react-router-dom";
+import AddNewWord from "./add-new-word";
+import useVocabulary from "../../../context/useVocabulary";
+
+vi.mock("../../../context/useVocabulary", () => ({ default: vi.fn() }));
+vi.mock("../../../context/DialogContext/useDialog", () => ({ default: () => ({ openDialog: vi.fn() }) }));
+vi.mock("react-i18next", () => ({ useTranslation: () => ({ t: (key) => key }) }));
+vi.mock("react-toastify", () => ({ toast: { success: vi.fn(), error: vi.fn(), info: vi.fn() } }));
+afterEach(() => { cleanup(); vi.resetAllMocks(); });
+
+function renderAddWord(state) {
+  const createConcept = vi.fn().mockResolvedValue({});
+  const getFiltredCategories = vi.fn();
+  useVocabulary.mockReturnValue({
+    categories: [], loading: false, createConcept, getFiltredCategories,
+    clearCategories: vi.fn(),
+    nativeLanguage: { id: 1, language_name: "Deutsch" },
+    userLanguages: [{ id: 2, language_name: "Englisch" }],
+  });
+  const { container } = render(
+    <MemoryRouter initialEntries={[{ pathname: "/my-quiz/add-new-word", state }]}>
+      <AddNewWord />
+    </MemoryRouter>,
+  );
+  return {
+    user: userEvent.setup(), createConcept, getFiltredCategories,
+    words: container.querySelectorAll('input[name="word"]'),
+    language: container.querySelector('select[name="language"]'),
+    submit: container.querySelector('button[type="submit"]'),
+  };
+}
+
+it("prefills the translated pair, loads categories, and saves edited words", async () => {
+  const { user, words, language, submit, createConcept, getFiltredCategories } = renderAddWord({
+    translations: [{ language: "1", word: "Hallo" }, { language: "2", word: "Hello" }],
+  });
+  expect(words[0].value).toBe("Hallo");
+  expect(words[1].value).toBe("Hello");
+  expect(language.value).toBe("2");
+  expect(getFiltredCategories).toHaveBeenCalledWith("2");
+  await user.clear(words[1]);
+  await user.type(words[1], "Hi");
+  await user.click(submit);
+  expect(createConcept).toHaveBeenCalledWith({
+    category: "", translations: [
+      { language: 1, word: "Hallo", tip: "", sentence: "" },
+      { language: "2", word: "Hi", tip: "", sentence: "" },
+    ],
+  });
+});
+
+it("keeps the form empty when opened without a translation", () => {
+  const { words, language, getFiltredCategories } = renderAddWord();
+  expect(words[0].value).toBe("");
+  expect(words[1].value).toBe("");
+  expect(language.value).toBe("");
+  expect(getFiltredCategories).not.toHaveBeenCalled();
+});
