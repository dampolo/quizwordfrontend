@@ -0,0 +1,93 @@
+@use "../../../styles/basic.scss";
+
+.all-category-words {
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  width: 100%;
+  padding: 2rem;
+  background: basic.$qw-bg-quiz;
+  color: #222;
+
+  .word-list {
+    background: basic.$qw-fourth;
+    border: 1px solid #ececec;
+    border-radius: basic.$qw-border-radius;
+    overflow-x: auto;
+  }
+
+  .list-head,
+  .list-row {
+    display: grid;
+    grid-template-columns: 90px 3.5fr 160px 140px 80px;
+    align-items: center;
+    min-width: 650px;
+  }
+
+  .list-head {
+    background: #eef5ff;
+    padding: 1rem;
+    font-size: 0.85rem;
+    text-transform: uppercase;
+    font-weight: 600;
+    color: #888;
+  }
+
+  .list-row {
+    padding: 1.2rem 1rem;
+    border-top: 1px solid #efefef;
+
+    &:hover { background: #fafcff; }
+  }
+
+  .rank {
+    text-align: center;
+    color: #4b38f5;
+    font-weight: 700;
+  }
+
+  .word {
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 0.3rem;
+
+    h3 { color: #4738d6; margin: 0; font-size: 1rem; }
+    p { margin: 0; color: #444; }
+    span { color: #bbb; font-size: 1.2rem; }
+  }
+
+  .badge {
+    display: inline-flex;
+    padding: 0.3rem 0.8rem;
+    border-radius: 999px;
+    font-size: 0.75rem;
+    font-weight: 600;
+  }
+
+  .streak {
+    display: flex;
+    align-items: center;
+    gap: 0.4rem;
+
+    strong { font-size: 1rem; }
+    span { color: #777; }
+  }
+
+  .actions {
+    display: flex;
+    justify-content: center;
+
+    a {
+      padding: 0.5rem;
+      border-radius: basic.$qw-border-radius;
+      margin: 0;
+
+      &:hover { background-color: basic.$color-hover; }
+    }
+  }
+}
+
+@media (max-width: 46rem) {
+  .all-category-words { padding: 1rem 0.5rem; }
+}
